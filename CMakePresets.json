{
    "version": 3,
    "configurePresets": [
        {
            "name": "debug",
            "description": "CLogger Debug profile",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/debug",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release",
            "description": "CLogger Release profile",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}